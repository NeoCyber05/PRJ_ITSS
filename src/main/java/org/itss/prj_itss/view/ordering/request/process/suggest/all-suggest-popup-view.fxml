<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.itss.prj_itss.view.ordering.request.process.suggest.AllSuggestPopupView"
      spacing="16"
      prefWidth="960"
      prefHeight="720"
      styleClass="allocation-dialog-root">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label fx:id="titleLabel" styleClass="allocation-dialog-title"/>
    <Label fx:id="subtitleLabel" wrapText="true" styleClass="allocation-subtitle"/>

    <ScrollPane fitToWidth="true"
                prefHeight="600"
                styleClass="transparent-scroll-pane">
        <content>
            <VBox fx:id="plansBox" spacing="14"/>
        </content>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT">
        <children>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeButton"
                    text="Đóng"
                    styleClass="forest-secondary-button"/>
        </children>
    </HBox>
</VBox>

