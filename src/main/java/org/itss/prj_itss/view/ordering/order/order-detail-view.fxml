<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           style="-fx-background-color: #F3F7FB;">
    <children>
        <StackPane fx:id="backgroundContainer"/>
        <Region fx:id="backdrop"
                style="-fx-background-color: rgba(15,23,42,0.34);"/>
        <HBox alignment="CENTER_RIGHT">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox minWidth="540"
                      prefWidth="540"
                      style="-fx-background-color: white; -fx-background-radius: 24 0 0 24; -fx-border-radius: 24 0 0 24;">
                    <children>
                        <BorderPane fx:id="panelRoot"
                                    maxWidth="1.7976931348623157E308"
                                    style="-fx-background-color: transparent;"
                                    VBox.vgrow="ALWAYS">
                            <top>
                                <VBox spacing="18"
                                      style="-fx-background-color: transparent; -fx-border-color: transparent transparent #E7EDF5 transparent; -fx-border-width: 0 0 1 0;">
                                    <padding>
                                        <Insets top="28" right="28" bottom="22" left="28"/>
                                    </padding>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="14">
                                            <children>
                                                <Button onAction="#handleBackAction"
                                                        text="‹"
                                                        style="-fx-background-color: white; -fx-border-color: #D9E2EE; -fx-border-radius: 10; -fx-background-radius: 10; -fx-text-fill: #475569; -fx-font-size: 26px; -fx-font-weight: bold; -fx-min-width: 38; -fx-min-height: 38; -fx-cursor: hand;"/>
                                                <VBox spacing="6">
                                                    <children>
                                                        <Label text="Chi tiết đơn hàng"
                                                               style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                                                        <Label fx:id="subtitleLabel"
                                                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7B8DA6;"/>
                                                    </children>
                                                </VBox>
                                                <Region fx:id="cancelSpacer"
                                                        managed="false"
                                                        visible="false"
                                                        HBox.hgrow="ALWAYS"/>
                                                <Button fx:id="cancelButton"
                                                        managed="false"
                                                        onAction="#handleCancelOrderAction"
                                                        text="Hủy đơn hàng"
                                                        visible="false"
                                                        style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-border-color: #F87171; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-weight: bold; -fx-cursor: hand;"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="topStatusContainer"
                                              alignment="CENTER_LEFT"/>
                                    </children>
                                </VBox>
                            </top>
                            <center>
                                <ScrollPane fx:id="scrollPane"
                                            fitToWidth="true"
                                            hbarPolicy="NEVER"
                                            style="-fx-background-color: transparent; -fx-background: transparent;">
                                    <BorderPane.margin>
                                        <Insets top="0" right="4" bottom="24" left="4"/>
                                    </BorderPane.margin>
                                    <content>
                                        <VBox fx:id="contentBox" spacing="22">
                                            <padding>
                                                <Insets top="16" right="24" bottom="16" left="24"/>
                                            </padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </center>
                        </BorderPane>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
