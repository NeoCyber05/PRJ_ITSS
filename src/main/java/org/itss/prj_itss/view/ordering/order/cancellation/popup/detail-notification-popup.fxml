<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="860"
      spacing="0"
      styleClass="cancelled-order-modal-card"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.itss.prj_itss.view.ordering.order.cancellation.popup.DetailNotificationPopupView">
    <children>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="cancelled-order-modal-header" style="-fx-background-color: #ECFDF5;">
            <children>
                <StackPane styleClass="cancelled-order-modal-icon" style="-fx-background-color: #D1FAE5;">
                    <children>
                        <Label text="✓"
                               styleClass="cancelled-order-modal-icon-text" style="-fx-text-fill: #059669;"/>
                    </children>
                </StackPane>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Chi tiết yêu cầu đặt hàng"
                               styleClass="cancelled-order-modal-title" style="-fx-text-fill: #065F46;"/>
                        <Label fx:id="subtitleLabel"
                               wrapText="true"
                               styleClass="cancelled-order-modal-subtitle"/>
                    </children>
                </VBox>
                <Button text="×"
                        onAction="#handleCloseAction"
                        styleClass="cancelled-order-modal-close-button"/>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="cancelled-order-scroll"
                    style="-fx-max-height: 480px;">
            <content>
                <VBox fx:id="container"
                      spacing="18"
                      styleClass="cancelled-order-content">
                    <padding>
                        <Insets top="20" right="28" bottom="20" left="28"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT"
              spacing="12"
              styleClass="cancelled-order-modal-footer">
            <children>
                <Button text="Về danh sách đơn hàng"
                        onAction="#handleCloseAction"
                        styleClass="cancelled-order-primary-button"/>
            </children>
        </HBox>
    </children>
</VBox>
