<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="540"
      spacing="0"
      styleClass="cancelled-order-modal-card"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.itss.prj_itss.view.ordering.order.cancellation.popup.CancelProcessingPopupView">
    <children>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="cancelled-order-modal-header">
            <children>
                <StackPane styleClass="cancelled-order-modal-icon" style="-fx-background-color: #FEF2F2;">
                    <children>
                        <Label text="⚠"
                               styleClass="cancelled-order-modal-icon-text" style="-fx-text-fill: #DC2626;"/>
                    </children>
                </StackPane>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Hủy xử lý"
                               styleClass="cancelled-order-modal-title"/>
                        <Label text="Bạn có chắc chắn muốn hủy xử lý phân bổ đơn hàng này? Dữ liệu đang nhập sẽ không được lưu."
                               wrapText="true"
                               styleClass="cancelled-order-modal-subtitle"/>
                    </children>
                </VBox>
                <Button text="×"
                        onAction="#handleCancelAction"
                        styleClass="cancelled-order-modal-close-button"/>
            </children>
        </HBox>

        <HBox alignment="CENTER_RIGHT"
              spacing="12"
              styleClass="cancelled-order-modal-footer">
            <children>
                <Button text="Cancel"
                        onAction="#handleCancelAction"
                        styleClass="cancelled-order-secondary-button"/>
                <Button text="Xác nhận hủy"
                        onAction="#handleConfirmAction"
                        styleClass="cancelled-order-primary-button" style="-fx-background-color: #DC2626; -fx-text-fill: white;"/>
            </children>
        </HBox>
    </children>
</VBox>
