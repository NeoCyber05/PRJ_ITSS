<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="860"
      spacing="0"
      styleClass="cancelled-order-modal-card"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.itss.prj_itss.view.ordering.order.cancellation.suggestion.OrderSuggestionPopupView">
    <children>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="cancelled-order-modal-header">
            <children>
                <StackPane styleClass="cancelled-order-modal-icon">
                    <children>
                        <Label text="✦"
                               styleClass="cancelled-order-modal-icon-text"/>
                    </children>
                </StackPane>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Gợi ý phân bổ tự động"
                               styleClass="cancelled-order-modal-title"/>
                        <Label text="Chọn chiến lược phân bổ phù hợp với nhu cầu"
                               wrapText="true"
                               styleClass="cancelled-order-modal-subtitle"/>
                    </children>
                </VBox>
                <Button text="×"
                        onAction="#handleCloseAction"
                        styleClass="cancelled-order-modal-close-button"/>
            </children>
        </HBox>

        <VBox spacing="14"
              styleClass="cancelled-order-modal-body">
             <children>
                 <HBox spacing="14" alignment="CENTER">
                     <padding>
                         <Insets top="10" right="0" bottom="10" left="0"/>
                     </padding>
                     <children>
                         <!-- Option 1 Card -->
                         <VBox spacing="12" styleClass="cancelled-order-suggestion-card, cancelled-order-plan-low-cost" prefWidth="240" minWidth="240">
                             <padding>
                                 <Insets top="14" right="14" bottom="14" left="14"/>
                             </padding>
                             <children>
                                 <HBox alignment="CENTER_LEFT" spacing="6">
                                     <children>
                                         <Label text="Option 1" styleClass="cancelled-order-muted-text" style="-fx-font-size: 11px;"/>
                                         <Region HBox.hgrow="ALWAYS"/>
                                         <Label text="Khuyên dùng" styleClass="cancelled-order-pill, cancelled-order-pill-warning" style="-fx-font-size: 10px; -fx-padding: 2 6;"/>
                                     </children>
                                 </HBox>
                                 <Label text="Chi phí vận chuyển thấp" styleClass="cancelled-order-section-title" style="-fx-font-size: 14px; -fx-font-weight: bold;" wrapText="true"/>
                                 <Label text="Tuân thủ tuyệt đối ưu tiên đường tàu, chọn site có tồn kho lớn nhất trước. Chi phí vận chuyển tối ưu nhất." styleClass="cancelled-order-muted-text" style="-fx-font-size: 12px;" wrapText="true" minHeight="80" prefHeight="80"/>
                                 <Button text="Áp dụng Option 1" onAction="#handleApplyOption1" styleClass="cancelled-order-primary-button" maxWidth="1.7976931348623157E308"/>
                             </children>
                         </VBox>

                         <!-- Option 2 Card -->
                         <VBox spacing="12" styleClass="cancelled-order-suggestion-card, cancelled-order-plan-simple" prefWidth="240" minWidth="240">
                             <padding>
                                 <Insets top="14" right="14" bottom="14" left="14"/>
                             </padding>
                             <children>
                                 <HBox alignment="CENTER_LEFT" spacing="6">
                                     <children>
                                         <Label text="Option 2" styleClass="cancelled-order-muted-text" style="-fx-font-size: 11px;"/>
                                         <Region HBox.hgrow="ALWAYS"/>
                                         <Label text="Ít điểm nhập" styleClass="cancelled-order-pill, cancelled-order-pill-warning" style="-fx-font-size: 10px; -fx-padding: 2 6;"/>
                                     </children>
                                 </HBox>
                                 <Label text="Quản lý đơn giản" styleClass="cancelled-order-section-title" style="-fx-font-size: 14px; -fx-font-weight: bold;" wrapText="true"/>
                                 <Label text="Số lượng điểm nhập hàng ít nhất bằng cách chọn site tồn kho lớn nhất, sử dụng hàng không để giao nhanh." styleClass="cancelled-order-muted-text" style="-fx-font-size: 12px;" wrapText="true" minHeight="80" prefHeight="80"/>
                                 <Button text="Áp dụng Option 2" onAction="#handleApplyOption2" styleClass="cancelled-order-primary-button" maxWidth="1.7976931348623157E308"/>
                             </children>
                         </VBox>

                         <!-- Option 3 Card -->
                         <VBox spacing="12" styleClass="cancelled-order-suggestion-card, cancelled-order-plan-balanced" prefWidth="240" minWidth="240">
                             <padding>
                                 <Insets top="14" right="14" bottom="14" left="14"/>
                             </padding>
                             <children>
                                 <HBox alignment="CENTER_LEFT" spacing="6">
                                     <children>
                                         <Label text="Option 3" styleClass="cancelled-order-muted-text" style="-fx-font-size: 11px;"/>
                                         <Region HBox.hgrow="ALWAYS"/>
                                         <Label text="Kết hợp" styleClass="cancelled-order-pill, cancelled-order-pill-warning" style="-fx-font-size: 10px; -fx-padding: 2 6;"/>
                                     </children>
                                 </HBox>
                                 <Label text="Cân bằng" styleClass="cancelled-order-section-title" style="-fx-font-size: 14px; -fx-font-weight: bold;" wrapText="true"/>
                                 <Label text="Lô hàng lớn (≥ 50% nhu cầu) dùng tàu, lô hàng nhỏ dùng máy bay — cân bằng chi phí và tốc độ." styleClass="cancelled-order-muted-text" style="-fx-font-size: 12px;" wrapText="true" minHeight="80" prefHeight="80"/>
                                 <Button text="Áp dụng Option 3" onAction="#handleApplyOption3" styleClass="cancelled-order-primary-button" maxWidth="1.7976931348623157E308"/>
                             </children>
                         </VBox>
                     </children>
                 </HBox>
             </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT"
              spacing="12"
              styleClass="cancelled-order-modal-footer">
            <children>
                <Button text="Đóng"
                        onAction="#handleCloseAction"
                        styleClass="cancelled-order-secondary-button"/>
            </children>
        </HBox>
    </children>
</VBox>
