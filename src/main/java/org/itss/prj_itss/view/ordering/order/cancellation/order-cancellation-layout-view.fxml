<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.itss.prj_itss.view.ordering.order.cancellation.OrderCancellationLayoutView"
           styleClass="content-area">
    <children>
        <BorderPane styleClass="cancelled-order-root">
            <top>
                <VBox spacing="16" styleClass="cancelled-order-header">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <children>
                                <StackPane styleClass="cancelled-order-header-icon">
                                    <children>
                                        <Label text="📦" styleClass="cancelled-order-icon-text"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="titleLabel"
                                               text="Phân bổ đơn hàng bị hủy"
                                               styleClass="cancelled-order-title"/>
                                        <Label fx:id="subtitleLabel"
                                               styleClass="cancelled-order-subtitle"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox fx:id="suggestBar"
                              alignment="CENTER_LEFT"
                              spacing="16"
                              styleClass="cancelled-order-suggest-bar">
                            <children>
                                <Label text="Gợi ý tự động:"
                                       styleClass="cancelled-order-suggest-title"/>
                                <Label text="Chọn từ 6 chiến lược phân bổ"
                                       wrapText="true"
                                       styleClass="cancelled-order-suggest-copy"
                                       HBox.hgrow="ALWAYS"/>
                                <Button fx:id="suggestButton"
                                        text="Gợi ý phân bổ"
                                        onAction="#handleSuggestAction"
                                        styleClass="cancelled-order-primary-button"/>
                            </children>
                        </HBox>

                        <Label fx:id="feedbackLabel"
                               managed="false"
                               visible="false"
                               wrapText="true"
                               styleClass="cancelled-order-feedback"/>
                    </children>
                </VBox>
            </top>

            <center>
                <ScrollPane fx:id="contentScrollPane"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            styleClass="cancelled-order-scroll">
                    <content>
                        <StackPane fx:id="contentContainer" />
                    </content>
                </ScrollPane>
            </center>

            <bottom>
                <HBox fx:id="footerBar"
                      alignment="CENTER_LEFT"
                      spacing="16"
                      styleClass="cancelled-order-footer">
                    <children>
                        <Button fx:id="backToOrdersButton"
                                text="Danh sách đơn hàng"
                                onAction="#handleBackToOrders"
                                styleClass="cancelled-order-secondary-button"/>
                        <HBox fx:id="footerSummaryBox"
                              alignment="CENTER_LEFT"
                              spacing="10"
                              HBox.hgrow="ALWAYS"/>
                        <Button fx:id="secondaryActionButton"
                                managed="false"
                                visible="false"
                                onAction="#handleSecondaryAction"
                                styleClass="cancelled-order-secondary-button"/>
                        <Button fx:id="primaryActionButton"
                                onAction="#handlePrimaryAction"
                                styleClass="cancelled-order-primary-button"/>
                    </children>
                </HBox>
            </bottom>
        </BorderPane>

        <StackPane fx:id="modalOverlay"
                   managed="false"
                   visible="false"
                   styleClass="cancelled-order-modal-overlay">
            <children>
                <StackPane fx:id="modalContainer" />
            </children>
        </StackPane>
    </children>
</StackPane>
