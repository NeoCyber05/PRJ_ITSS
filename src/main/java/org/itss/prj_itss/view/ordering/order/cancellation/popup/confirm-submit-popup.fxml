<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="540"
      spacing="0"
      styleClass="cancelled-order-modal-card"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.itss.prj_itss.view.ordering.order.cancellation.popup.ConfirmSubmitPopupView">
    <children>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="cancelled-order-modal-header">
            <children>
                <StackPane styleClass="cancelled-order-modal-icon">
                    <children>
                        <Label text="✓"
                               styleClass="cancelled-order-modal-icon-text"/>
                    </children>
                </StackPane>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Gửi yêu cầu"
                               styleClass="cancelled-order-modal-title"/>
                        <Label text="Xác nhận gửi yêu cầu xử lý đơn hàng?"
                               wrapText="true"
                               styleClass="cancelled-order-modal-subtitle"/>
                    </children>
                </VBox>
                <Button text="×"
                        onAction="#handleCancelAction"
                        styleClass="cancelled-order-modal-close-button"/>
            </children>
        </HBox>

        <HBox alignment="CENTER_RIGHT"
              spacing="12"
              styleClass="cancelled-order-modal-footer">
            <children>
                <Button text="Cancel"
                        onAction="#handleCancelAction"
                        styleClass="cancelled-order-secondary-button"/>
                <Button text="Ok"
                        onAction="#handleConfirmAction"
                        styleClass="cancelled-order-primary-button"/>
            </children>
        </HBox>
    </children>
</VBox>
