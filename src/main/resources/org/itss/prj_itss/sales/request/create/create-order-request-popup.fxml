<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.itss.prj_itss.request.presentation.sales.create.CreateOrderRequestController"
           styleClass="request-detail-overlay">
    <children>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    pannable="true"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="AS_NEEDED"
                    styleClass="transparent-scroll-pane">
            <content>
                <StackPane fx:id="scrollContent">
                    <padding>
                        <Insets top="32" right="32" bottom="32" left="32"/>
                    </padding>
                    <children>
                        <VBox spacing="0"
                              styleClass="request-detail-card"
                              maxWidth="500">
                            <children>
                                <HBox spacing="16" alignment="CENTER_LEFT" styleClass="request-detail-header">
                                    <padding>
                                        <Insets top="20" right="20" bottom="16" left="24"/>
                                    </padding>
                                    <children>
                                        <Label text="Tạo yêu cầu nhập hàng mới" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="closeButton" text="✕" styleClass="request-detail-close-button"/>
                                    </children>
                                </HBox>

                                <VBox spacing="12">
                                    <padding>
                                        <Insets top="20" right="24" bottom="20" left="24"/>
                                    </padding>
                                    <children>
                                        <!-- Table Header -->
                                        <HBox spacing="12" alignment="CENTER_LEFT">
                                            <Label text="#" minWidth="30" style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
                                            <Label text="Mã hàng *" minWidth="150" style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
                                            <Label text="Số lượng *" minWidth="100" style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
                                            <Label text="Đơn vị *" minWidth="120" style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
                                            <Label text="Ngày nhận mong muốn *" minWidth="180" style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
                                        </HBox>
                                        <Line endX="752" stroke="#E2E8F0"/>

                                        <!-- Item List (1 Item for now) -->
                                        <VBox fx:id="itemsContainer" spacing="12">
                                            <children>
                                                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #F8FAFC; -fx-background-radius: 6; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-padding: 8;">
                                                    <Label text="1" minWidth="30" alignment="CENTER" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                                                    <TextField promptText="VD: MH-001" minWidth="150" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 4; -fx-padding: 6 10;"/>
                                                    <TextField promptText="0" minWidth="100" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 4; -fx-padding: 6 10;"/>
                                                    <TextField promptText="VD: Thùng" minWidth="120" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 4; -fx-padding: 6 10;"/>
                                                    <DatePicker promptText="dd/mm/yyyy" minWidth="180" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 4;"/>
                                                    <Button onAction="#handleDeleteRow" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4;">
                                                        <graphic>
                                                            <javafx.scene.shape.SVGPath content="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" fill="#EF4444" scaleX="0.8" scaleY="0.8"/>
                                                        </graphic>
                                                    </Button>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- Thêm mặt hàng button -->
                                        <Button fx:id="addItemButton" text="+ Thêm mặt hàng" style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-border-style: dashed; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </VBox>
                                <Line endX="800" stroke="#E2E8F0"/>
                                <!-- Footer -->
                                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-background-color: #F8FAFC; -fx-padding: 16 24; -fx-background-radius: 0 0 12 12;">
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="cancelButton" text="Hủy" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-text-fill: #334155; -fx-padding: 8 16; -fx-cursor: hand;"/>
                                    <Button fx:id="submitButton" text="Gửi yêu cầu nhập hàng" styleClass="btn-submit-order"/>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>
