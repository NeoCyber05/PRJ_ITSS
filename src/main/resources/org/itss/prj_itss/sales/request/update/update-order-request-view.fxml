<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.itss.prj_itss.request.presentation.sales.update.UpdateOrderRequestController"
            styleClass="sr-edit-root">

    <!-- ── Header ── -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="sr-edit-header">
            <Label fx:id="headerTitle" text="Chỉnh sửa yêu cầu" styleClass="sr-edit-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeButton" text="✕" styleClass="request-detail-close-button"/>
        </HBox>
    </top>

    <!-- ── Center (scrollable) ── -->
    <center>
        <ScrollPane fx:id="mainScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="transparent-scroll-pane"
                    style="-fx-background-color: white;">
            <VBox spacing="28" style="-fx-padding: 28 32;">

                <!-- Summary row -->
                <HBox spacing="40" styleClass="sr-edit-summary-row">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="MÃ YÊU CẦU" styleClass="request-detail-summary-label"/>
                        <Label fx:id="requestCodeLabel" text="YC-..." styleClass="request-detail-summary-value"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="NGÀY TẠO" styleClass="request-detail-summary-label"/>
                        <Label fx:id="createdAtLabel" text="--/--/----" styleClass="request-detail-summary-value"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="TRẠNG THÁI" styleClass="request-detail-summary-label"/>
                        <HBox fx:id="statusBadge" alignment="CENTER_LEFT" spacing="6"
                              style="-fx-background-color: #FEF3C7; -fx-background-radius: 12; -fx-padding: 4 12;"/>
                    </VBox>
                </HBox>

                <!-- Items section -->
                <VBox spacing="14">

                    <!-- Toolbar -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Danh sách mặt hàng" styleClass="request-detail-section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="selectedCountLabel" text="" managed="false" visible="false"
                               styleClass="sr-edit-selected-count"/>
                        <Button fx:id="bulkDeleteButton" text="🗑  Xóa đã chọn"
                                managed="false" visible="false"
                                styleClass="sr-edit-danger-button"/>
                        <Button fx:id="addItemButton" text="+ Thêm mặt hàng"
                                styleClass="forest-dark-button"/>
                    </HBox>

                    <!-- Search -->
                    <TextField fx:id="searchField"
                               promptText="🔍  Tìm theo mã hàng hoặc tên sản phẩm..."
                               styleClass="forest-filter-search"/>

                    <!-- Table -->
                    <VBox styleClass="sr-edit-table-shell">
                        <!-- Table header row -->
                        <HBox styleClass="sr-edit-table-header">
                            <Label text=""        prefWidth="44"  styleClass="sr-edit-th"/>
                            <Label text="MÃ HÀNG" prefWidth="120" styleClass="sr-edit-th"/>
                            <Label text="TÊN"     prefWidth="260" styleClass="sr-edit-th" HBox.hgrow="ALWAYS"/>
                            <Label text="SỐ LƯỢNG *"  prefWidth="130" styleClass="sr-edit-th"/>
                            <Label text="ĐƠN VỊ"      prefWidth="90"  styleClass="sr-edit-th"/>
                            <Label text="NGÀY NHẬN MONG MUỐN *" prefWidth="200" styleClass="sr-edit-th"/>
                            <Label text=""        prefWidth="50"  styleClass="sr-edit-th"/>
                        </HBox>
                        <TableView fx:id="itemsTable" prefHeight="320"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-table-header-border-color: transparent;">
                            <columns>
                                <TableColumn fx:id="checkboxColumn"         text="" prefWidth="44"  maxWidth="44"  resizable="false"/>
                                <TableColumn fx:id="merchandiseCodeColumn"  text="" prefWidth="120"/>
                                <TableColumn fx:id="merchandiseNameColumn"  text="" prefWidth="260"/>
                                <TableColumn fx:id="quantityColumn"         text="" prefWidth="130"/>
                                <TableColumn fx:id="unitColumn"             text="" prefWidth="90"/>
                                <TableColumn fx:id="desiredDateColumn"      text="" prefWidth="200"/>
                                <TableColumn fx:id="actionColumn"           text="" prefWidth="50"  maxWidth="50"  resizable="false"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Pagination -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="itemCountLabel" text="" styleClass="sr-edit-count-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox fx:id="paginationBox" alignment="CENTER" spacing="4"/>
                    </HBox>

                    <Label fx:id="errorLabel" text=""
                           style="-fx-text-fill: #DC2626; -fx-font-size: 12px; -fx-font-weight: bold;"
                           visible="false"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- ── Footer (sticky) ── -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="sr-edit-footer">
            <Button fx:id="cancelButton" text="Hủy bỏ"    styleClass="forest-outline-button"
                    style="-fx-padding: 9 24; -fx-font-size: 13px;"/>
            <Button fx:id="updateButton" text="Lưu thay đổi" styleClass="forest-primary-button"/>
        </HBox>
    </bottom>

</BorderPane>
