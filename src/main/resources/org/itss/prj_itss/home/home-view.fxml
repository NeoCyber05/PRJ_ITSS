<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.itss.prj_itss.home.HomeController"
            styleClass="content-area">
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="24">
                    <padding>
                        <Insets top="4" right="4" bottom="24" left="4"/>
                    </padding>
                    <children>
                        <HBox spacing="24"
                              style="-fx-background-color: linear-gradient(to right, #0F172A, #134E4A 72%); -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.18), 22, 0, 0, 8);">
                            <padding>
                                <Insets top="24" right="24" bottom="24" left="24"/>
                            </padding>
                            <children>
                                <VBox spacing="14" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="TRANG CHỦ"
                                               style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: #CCFBF1; -fx-background-radius: 999; -fx-padding: 5 12; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                        <Label text="Bộ phận đặt hàng quốc tế"
                                               wrapText="true"
                                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                        <Label text="Trang này là điểm vào nhanh để xem yêu cầu đã nhận, quản lý site và theo dõi đơn hàng đã tạo."
                                               wrapText="true"
                                               style="-fx-font-size: 13px; -fx-text-fill: #D6F4F1;"/>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <VBox spacing="14">
                            <children>
                                <Label text="Các màn chính"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                                <HBox fx:id="quickCardsContainer" spacing="16"/>
                            </children>
                        </VBox>

                        <HBox spacing="20">
                            <children>
                                <VBox spacing="0"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-color: #DCE5F1; -fx-border-radius: 20; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.05), 14, 0, 0, 4);">
                                    <children>
                                        <HBox alignment="CENTER_LEFT"
                                              style="-fx-border-color: transparent transparent #E6EDF5 transparent; -fx-border-width: 0 0 1 0;">
                                            <padding>
                                                <Insets top="18" right="20" bottom="16" left="20"/>
                                            </padding>
                                            <children>
                                                <Label text="Công việc cần xử lý"
                                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Button text="Mở danh sách"
                                                        onAction="#openReceivedRequests"
                                                        style="-fx-background-color: transparent; -fx-text-fill: #0F766E; -fx-padding: 0; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                                            </children>
                                        </HBox>
                                        <VBox fx:id="pendingRowsContainer" spacing="0"/>
                                    </children>
                                </VBox>

                                <VBox spacing="0"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-color: #DCE5F1; -fx-border-radius: 20; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.05), 14, 0, 0, 4);">
                                    <children>
                                        <HBox alignment="CENTER_LEFT"
                                              style="-fx-border-color: transparent transparent #E6EDF5 transparent; -fx-border-width: 0 0 1 0;">
                                            <padding>
                                                <Insets top="18" right="20" bottom="16" left="20"/>
                                            </padding>
                                            <children>
                                                <Label text="Cập nhật gần đây"
                                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                                            </children>
                                        </HBox>
                                        <VBox fx:id="activityRowsContainer" spacing="0"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
