<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.itss.prj_itss.ordering.request.process.preview.RequestProcessingPreviewDialogController"
      prefWidth="980"
      prefHeight="760"
      spacing="16"
      styleClass="request-preview-root">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <children>
        <Label text="Chi tiết phân bổ đơn hàng"
               styleClass="request-preview-title"/>
        <Label fx:id="subtitleLabel"
               styleClass="request-preview-subtitle"/>
        <ScrollPane fitToWidth="true"
                    prefHeight="620"
                    styleClass="transparent-scroll-pane">
            <content>
                <VBox fx:id="ordersBox" spacing="14"/>
            </content>
        </ScrollPane>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="backButton"
                        text="Quay lại"
                        styleClass="forest-secondary-button"/>
                <Button fx:id="sendButton"
                        text="Gửi đơn hàng"
                        styleClass="request-confirm-button"/>
            </children>
        </HBox>
    </children>
</VBox>
