<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.itss.prj_itss.request.detail.RequestDetailPopupController"
           styleClass="request-detail-overlay">
    <children>
        <ScrollPane fitToHeight="true"
                    pannable="true"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="AS_NEEDED"
                    styleClass="transparent-scroll-pane">
            <content>
                <StackPane fx:id="scrollContent">
                    <padding>
                        <Insets top="32" right="32" bottom="32" left="32"/>
                    </padding>
                    <children>
                        <HBox fx:id="dialogShell"
                              spacing="20"
                              alignment="TOP_CENTER">
                            <children>
                                <VBox fx:id="requestCard"
                                      spacing="0"
                                      styleClass="request-detail-card">
                                    <children>
                                        <HBox spacing="16"
                                              alignment="CENTER_LEFT"
                                              styleClass="request-detail-header">
                                            <padding>
                                                <Insets top="28" right="28" bottom="20" left="28"/>
                                            </padding>
                                            <children>
                                                <Label fx:id="titleLabel"
                                                       styleClass="request-detail-title"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Button fx:id="closeButton"
                                                        text="✕"
                                                        styleClass="request-detail-close-button"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="28"
                                              styleClass="request-detail-summary-row">
                                            <padding>
                                                <Insets top="24" right="28" bottom="28" left="28"/>
                                            </padding>
                                            <children>
                                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="MÃ YÊU CẦU"
                                                               styleClass="request-detail-summary-label"/>
                                                        <Label fx:id="requestCodeValueLabel"
                                                               styleClass="request-detail-summary-value"/>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="NGÀY TẠO"
                                                               styleClass="request-detail-summary-label"/>
                                                        <Label fx:id="createdDateValueLabel"
                                                               styleClass="request-detail-summary-value"/>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="NGÀY ĐẾN HẠN SỚM NHẤT"
                                                               styleClass="request-detail-summary-label"/>
                                                        <Label fx:id="earliestDeadlineValueLabel"
                                                               styleClass="request-detail-summary-danger"/>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="TRẠNG THÁI"
                                                               styleClass="request-detail-summary-label"/>
                                                        <HBox fx:id="statusContainer"
                                                              alignment="CENTER_LEFT"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <VBox spacing="28">
                                            <padding>
                                                <Insets top="28" right="28" bottom="28" left="28"/>
                                            </padding>
                                            <children>
                                                <VBox spacing="16">
                                                    <children>
                                                        <Label text="Danh sách mặt hàng"
                                                               styleClass="request-detail-section-title"/>
                                                        <VBox fx:id="requestItemsTable"
                                                              spacing="0"
                                                              styleClass="request-detail-table"/>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="16">
                                                    <children>
                                                        <Label text="Danh sách đơn hàng đã phân bổ"
                                                               styleClass="request-detail-section-title"/>
                                                        <VBox fx:id="allocatedOrdersTable"
                                                              spacing="0"
                                                              styleClass="request-detail-table"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                                <StackPane fx:id="orderDetailContainer"
                                           managed="false"
                                           visible="false"
                                           styleClass="request-detail-order-panel"/>
                            </children>
                        </HBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>
