<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.itss.prj_itss.request.RequestProcessingController"
            style="-fx-background-color: #F5F9F6;">
    <top>
        <HBox style="-fx-background-color:white; -fx-border-color:transparent transparent #D8E8DD transparent; -fx-border-width:0 0 1 0; -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 2);">
            <padding>
                <Insets top="18" right="28" bottom="18" left="28"/>
            </padding>
            <children>
                <VBox spacing="3">
                    <children>
                        <Label text="XỬ LÝ YÊU CẦU"
                               style="-fx-font-size:11px; -fx-font-weight:bold; -fx-text-fill:#2E6F40;"/>
                        <Label fx:id="requestCodeLabel"
                               style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#1a2e22;"/>
                        <Label fx:id="requestSummaryLabel"
                               style="-fx-font-size:12px; -fx-text-fill:#6B7C72;"/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="requestStatusLabel"
                       style="-fx-background-color:#FFF3E0; -fx-text-fill:#E65100; -fx-background-radius:8; -fx-padding:6 14; -fx-font-size:13px; -fx-font-weight:bold;"/>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: #F5F9F6; -fx-background: #F5F9F6;">
            <content>
                <VBox spacing="20" style="-fx-background-color: #F5F9F6;">
                    <padding>
                        <Insets top="20" right="28" bottom="20" left="28"/>
                    </padding>
                    <children>
                        <VBox fx:id="siteFilterContainer"/>
                        <VBox fx:id="itemsTableContainer"/>
                        <VBox fx:id="allocationContainer"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox style="-fx-background-color:white; -fx-border-color:#D8E8DD transparent transparent transparent; -fx-border-width:1 0 0 0;">
            <padding>
                <Insets top="16" right="28" bottom="16" left="28"/>
            </padding>
            <children>
                <Button text="Danh sách yêu cầu"
                        onAction="#goBack"
                        style="-fx-background-color: white; -fx-text-fill: #2E6F40; -fx-background-radius: 7; -fx-border-color: #2E6F40; -fx-border-radius: 7; -fx-border-width: 1.5; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 20;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Xác nhận và gửi"
                        onAction="#handleConfirm"
                        style="-fx-background-color:#253D2C; -fx-text-fill:white; -fx-background-radius:8; -fx-font-size:14px; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:12 32;"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
